# Production origin. Canonical tags, the sitemap, robots.txt and the OG
# image URL are all absolute, so this has to be the real domain in
# production. On Vercel it falls back to the project's production URL;
# elsewhere it falls back to http://localhost:3000.
NEXT_PUBLIC_SITE_URL=

NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2025-09-01

SANITY_API_WRITE_TOKEN=

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
